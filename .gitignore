# Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# Subpackage lockfiles in monorepo (only root package-lock.json is kept)
apps/*/package-lock.json
libs/*/package-lock.json

# Compiled Output & Caches
dist/
**/dist/
dist-tsc/
build/
**/build/
out-tsc/
.angular/
**/.angular/
*.tsbuildinfo

# Environment & Secret files
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
!.env.example
!**/.env.example

# Logs & Diagnostics
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs & Editor configs
.idea/
**/.idea/
.vscode/
**/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Coverage & Tests
coverage/
