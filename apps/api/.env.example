# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=naisei_dev
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Storage (Cloudflare R2 / S3 - Optional for local dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=naisei-assets
R2_PUBLIC_DOMAIN=
